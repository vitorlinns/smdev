# Copie para .env e ajuste se precisar. Todas as variáveis são opcionais —
# os valores abaixo já são os padrões usados quando nada é definido.

# Porta do servidor SMTP fake (pra onde sua aplicação envia os emails)
SMTP_PORT=1025

# Porta da API HTTP + UI web (http://localhost:8025)
HTTP_PORT=8025

# Quantas mensagens manter em memória antes de descartar as mais antigas
INBOX_MAX_MESSAGES=200
