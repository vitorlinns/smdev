{
  "name": "smdev",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "scripts": {
    "build:server": "tsc -p tsconfig.json",
    "build:client": "esbuild src/web/app.ts --bundle --outfile=dist/web/app.js --target=es2020",
    "build:assets": "mkdir -p dist/web && cp src/web/index.html src/web/styles.css dist/web/",
    "build": "npm run build:server && npm run build:client && npm run build:assets",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "express": "^5.2.1",
    "mailparser": "^3.9.14",
    "smtp-server": "^3.19.2",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.20.1",
    "@types/smtp-server": "^3.5.13",
    "esbuild": "^0.28.2",
    "nodemailer": "^9.0.3",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
